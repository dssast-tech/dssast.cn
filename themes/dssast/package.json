{
  "name": "dssast-theme",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "watch": "sass --load-path=node_modules src/scss/main.scss dist/app.css --watch",
    "build:css": "sass src/scss/main.scss dist/app.css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/main.js --bundle --minify --outfile=dist/app.js",
    "build": "npm run build:css && npm run build:js && chmod 664 dist/app.css dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alpinejs/collapse": "^3.17.5",
    "alpinejs": "^3.17.5",
    "lucide": "^1.77.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.108.2"
  }
}
